# ─────────────────────────────────────────────────────────────
# Vinato — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Store Contact ─────────────────────────────────────────────
# Displayed in the store footer and used as defaults
STORE_SUPPORT_EMAIL=hello@yourdomain.com
STORE_PHONE=+1 (000) 000-0000
STORE_WHATSAPP=+10000000000
STORE_INSTAGRAM=https://instagram.com/yourhandle
